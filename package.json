{
  "name": "choyeon-note",
  "version": "1.0.0",
  "description": "Choyeon Note - A beautiful acrylic design note-taking application",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "Choyeon",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5176 && electron .\"",
    "electron:build": "vite build && node scripts/check-dist-fresh.mjs && electron-builder --publish never",
    "electron:build:win": "vite build && node scripts/check-dist-fresh.mjs && electron-builder --win --publish never",
    "generate:icons": "node scripts/generate-icons.js",
    "build:c": "node scripts/build-c.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.298.0",
    "marked": "^11.1.0",
    "mermaid": "^11.16.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.32",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.7",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.1"
  },
  "build": {
    "appId": "com.choyeon.note",
    "productName": "Choyeon Note",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icons/**/*",
      "package.json",
      "!dist/**/*.map",
      "!**/*.md",
      "!**/__tests__/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Choyeon",
      "repo": "choyeon-note"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "ChoyeonNote-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icons/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "ChoyeonNote-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false,
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icons/icon.png",
      "category": "Utility",
      "artifactName": "choyeon-note-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico"
    },
    "portable": {
      "artifactName": "ChoyeonNote-Portable-${version}-${arch}.${ext}"
    }
  }
}
